float GGXNDF(vec3 wm, float a)
{
    float costheta2 = wm.z * wm.z;
    float tantheta2 = -1.0 + 1.0 / costheta2;
    float denom = pi * costheta2 * costheta2 * pow((a*a + tantheta2), 2.0);
    return a*a / denom; 
}
vec3 Fresnel(vec3 wi, vec3 wm, vec3 f0)
{
    return f0 + (1-f0) * pow(1.0 -  dot(wi, wm), 5.0);
}
float lambda(vec3 w, vec3 n, float a)
{
    float costheta2 = dot(w, n);
    costheta2 *= costheta2;
    float tantheta2 = -1.0 + 1.0 / costheta2;
    return 0.5 * (sqrt(1.0 + a*a*tantheta2) - 1.0);
}
vec3 RandomWm(inout uint seed, vec3 w, float a)
{
    float r1 = RandomFloat(seed);
    float r2 = RandomFloat(seed);
    float thetam = atan(a * sqrt(r1 / (1 - r1)));
    float phim = 2 * pi * r2;
    float x = sin(thetam) * cos(phim);
    float y = sin(thetam) * sin(phim);
    float z = cos(thetam);


    vec3 axis[3];
    axis[2] = normalize(w);
    vec3 an = (abs(axis[2].x) > 0.9) ? vec3(0.0, 1.0, 0.0) : vec3(1, 0, 0);
    axis[1] = normalize(cross(axis[2], an));
    axis[0] = cross(axis[2], axis[1]);

    return axis[0] * x + axis[1] * y + axis[2] * z; 

}
float TorSpPdf(vec3 wo, vec3 wm, vec3 n, float a)
{
    float D = GGXNDF(wm, a);
    float cosThetaM = max(dot(n, wm), 0.0);
    float cosWoWm = max(dot(wo, wm), 0.0);

    return (D * cosThetaM) / (4.0 * cosWoWm);
}
float G(vec3 wo, vec3 wi, vec3 n, float a)
{
    return (1 / (1 + lambda(wo,n, a) + lambda(wi,n, a)));
}
void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(img);

    float u = (float(pix.x) + 0.5) / float(size.x);
    float v = (float(pix.y) + 0.5) / float(size.y);

    u = u * 2.0 - 1.0;
    v = v * 2.0 - 1.0;

    vec4 target = InvProj * vec4(u, v , 1.0, 1.0);

    ray r;
    r.dir = vec3(InvView * vec4(normalize(vec3(target) / target.w), 0));
    r.pos = CamPos;

    vec3 rayTraversalInfo = vec3(1.0);
    vec3 rayColor = vec3(0.0);
    uint seed =
    uint(pix.x) * 1973u +
    uint(pix.y) * 9277u +
    uframe  * 26699u + 1u;
    for(int bounces = 0; bounces < maxBounces; bounces++)
    {

        hitInfo HitInfo = GetHitInfoAABB(r);
        // if nothing got hit, just return a base color.
        if (HitInfo.matIndex == -1) {
            if(skyColor == 1)
            {
                float a = 0.5*(r.dir.y + 1);  
                vec3 sky = (1-a)*vec3(1) + a * vec3(0.5, 0.7, 1.0);
                rayColor = rayTraversalInfo * sky;  // environment brightness
            }
            break;
        }

        //Something got hit.
        vec3 HitPoint = r.pos + r.dir * HitInfo.dist;
        vec3 outwardN = HitInfo.normal;
        bool frontFace = dot(r.dir, outwardN) < 0.0;
        vec3 n = frontFace ? outwardN : -outwardN;
        material hitMat = materials[HitInfo.matIndex];

        r.pos = HitPoint + n * 0.001;

        float a  = hitMat.roughness;
        vec3 wo = normalize(-r.dir);
        vec3 wm = RandomWm(seed, n, a);
        vec3 wi = -wo + 2.0 * dot(wo, wm) * wm;
        if(dot(wi, n) <= 0.0 || dot(wo, n) <= 0.0)
            continue;

        vec3 f0 = mix(vec3(1.0), hitMat.albedo, hitMat.metallic);
        float NoV = max(dot(n, wo), 0.0);
        float NoL = max(dot(n, wi), 0.0);

        vec3 brdf = GGXNDF(wm, a)
                * Fresnel(wi, wm, f0)
                * G(wo, wi, n, a)
                / (4.0 * NoV * NoL);
        float pdf = TorSpPdf(wo, wm,n,a);
        vec3 mSample = brdf * NoL / pdf;


        r.dir = wi;
        rayTraversalInfo *= mSample;
        rayColor += rayTraversalInfo * hitMat.emmColor;
    }
    vec4 prev = imageLoad(img, pix);

    imageStore(img, pix, vec4(prev.rgb + rayColor, 1.0));
}