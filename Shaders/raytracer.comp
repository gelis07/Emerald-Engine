#version 430 core
layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform image2D img;
const float pi = 3.14159265359;
const int maxBounces = 5;
/*
    Material type indeces.
