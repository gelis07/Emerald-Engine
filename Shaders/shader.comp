#version 430 core


layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform image2D imgAccum;


uniform float AR;
uniform float tfov;
uniform vec3 CamPos;
/*
    1 Lambertian
    2 Metal
*/
struct sphere 
{
    vec3 point;
    float radius;
    int material;
    vec3 albedo;
};

//Scene Vars
uniform sphere Spheres[10];
uniform int SphereCount;
uniform int frameIndex;
uniform int accumulate;
uint PCGHash(uint seed)
{
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float RandomFloat(inout uint seed)
{
    seed = PCGHash(seed);
    return float(seed) / 4294967295.0;
}

vec3 RandomVec3(inout uint seed)
{
    return vec3(
    RandomFloat(seed) * 2.0 - 1.0,
    RandomFloat(seed) * 2.0 - 1.0,
    RandomFloat(seed) * 2.0 - 1.0);
}

vec3 RandomOnHemisphere(uint seed, vec3 normal)
{
    vec3 vector = RandomVec3(seed);
    if(dot(vector, normal) > 0)
    {
        return vector;
    }else
    {
        return -vector;
    }
}

vec3 LambertianScatter(vec3 Normal, uint seed)
{
    return Normal + RandomVec3(seed);
}

vec3 ReflectionScatter(vec3 Normal, vec3 IncomingRay)
{
    return reflect(IncomingRay, Normal);
}

void main()
{


    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(imgAccum);

    float u = (pix.x + 0.5) / size.x * 2.0 - 1.0;
    float v = (pix.y + 0.5) / size.y * 2.0 - 1.0;

    vec3 P = vec3(u * tfov * AR, v * tfov, 1.0);
    vec3 r = normalize(P);
    vec3 contribution = vec3(1.0);
    vec3 finalColor = vec3(0.0);
    vec3 StartPoint = CamPos;
    uint seed =
        uint(pix.x) * 1973u +
        uint(pix.y) * 9277u +
        frameIndex  * 26699u + 1u;;

    for(int iter = 0; iter < 10; iter++)
    {
        float nearestT = 1e30;
        int hitIndex = -1;
        for(int i = 0; i < SphereCount; i++)
        {
            vec3 Pc = StartPoint-Spheres[i].point;
            float Discr = (dot(Pc, r)*dot(Pc,r) - dot(Pc, Pc) + Spheres[i].radius*Spheres[i].radius);
            // float t = 0;
            if(Discr >= 0)
            {
                float t = -dot(Pc, r) - sqrt(Discr);
                if(t > 0.001 && t < nearestT)
                {
                    nearestT = t;
                    hitIndex = i;
                }
            }

        }
        if (hitIndex == -1) {
            float a = 0.5*(r.y + 1);  
            vec3 sky = (1-a)*vec3(1) + a * vec3(0.5, 0.7, 1.0);
            finalColor = contribution * sky;  // environment brightness
            break;
        }
        vec3 HitPoint = StartPoint + r * nearestT;
        vec3 Normal = normalize(HitPoint - Spheres[hitIndex].point);

        StartPoint = HitPoint + Normal * 0.001;
        if(Spheres[hitIndex].material == 1)
        {
            r = LambertianScatter(Normal, seed);
        }else if(Spheres[hitIndex].material == 2)
        {
            r = ReflectionScatter(Normal, r);
        }

        contribution *= Spheres[hitIndex].albedo;
    }
    vec3 newColor = finalColor;
    if(accumulate == 1)
    {
        vec3 oldColor = imageLoad(imgAccum, pix).rgb;
        newColor = (oldColor * float(frameIndex - 1) + finalColor) / float(frameIndex);
    }
    imageStore(imgAccum, pix, vec4(newColor, 1.0));
}