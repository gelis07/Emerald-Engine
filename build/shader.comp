#version 430 core


layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform image2D imgOut;


uniform float AR;
uniform float tfov;

//Scene Vars
uniform vec3 SPoint;
uniform float SRadius;
void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(imgOut);

    float u = (pix.x + 0.5) / size.x * 2.0 - 1.0;
    float v = (pix.y + 0.5) / size.y * 2.0 - 1.0;

    vec3 P = vec3(u * tfov * AR, v * tfov, 1.0);
    vec3 r = normalize(P); 
    vec3 Pc = -SPoint;
    float Discr = (dot(Pc, r)*dot(Pc,r) - dot(Pc, Pc) + SRadius*SRadius);
    // float t = 0;
    if(Discr >= 0)
    {
        // t = -dot(Pc, r) - sqrt(Discr);
        imageStore(imgOut, pix, vec4(1.0, 0.0, 0.0, 1.0));
    }
}



